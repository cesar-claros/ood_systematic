# X8 Pool A caches (features come back from the HPC; synthetic dir is the self-test)
pool_a_features/
x8_pool_a/_synthetic_features/
nc_csf_predictivity/outputs/pool_a/*SYNTHETIC*

# Generated scratch variants (sed copy of stats_eval.py, FPR@95-only metric branch)
stats_eval_fpr_only.py

# Generated aggregation outputs of the new-CSF pilot (regenerable via
# aggregate_new_csfs_pilot.py from the per-checkpoint stats on the HPC) and
# the --include-new-csfs rerun artifacts of pool_a_analysis.py (regenerable
# from the tracked feature-extraction pipeline; the committed pool_a outputs
# are the reference the analyses read)
new_csfs_pilot_summary*
nc_csf_predictivity/outputs/pool_a/*_newcsfs*

# Exception to the *.sh rule: the Pool A extraction runner must sync to the HPC
!x8_pool_a/run_pool_a_hpc.sh
!run_new_csfs_pilot.sh
!run_new_csfs_vit_all.sh
# x9 ImageNet-scale experiments are tracked from the start (plan decision 5)
!x9_imagenet/*.sh
# X6 campaign stage-1 runner (*.sh) and its dev-pool manifest (*.txt) must
# sync to the HPC
!x6_spectral/run_x6_measure.sh
!x6_spectral/manifest_dev_pool.txt
# X6 measurement outputs stay on the HPC (analysis happens there; JSON/NPZ/logs).
# Contents-level pattern (not `outputs/`) so git can descend for the exceptions.
x6_spectral/outputs/*
# EXCEPT the pass-5.1 l14 confirmatory-rerun audit trail (re-review 5.1):
# the lock manifest and the final outcome/scoring tables are TRACKED so the
# prediction-before-outcome sequencing is externally auditable
!x6_spectral/outputs/poola_l14/
x6_spectral/outputs/poola_l14/*
!x6_spectral/outputs/poola_l14/manifest.json
!x6_spectral/outputs/poola_l14/outcomes.csv
!x6_spectral/outputs/poola_l14/poola_scoring.csv
!x6_spectral/outputs/poola_l14/poola_report.md
nc_csf_predictivity/outputs/pool_a/*_harmonized*
